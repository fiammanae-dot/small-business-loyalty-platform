# Required. The app refuses to start in production if either is missing (src/lib/env.ts).
DATABASE_URL="postgresql://USER:PASSWORD@DATABASE_HOST:5432/loyalty_platform?schema=public"
SESSION_SECRET="change-this-to-a-long-random-secret-before-production"

DEV_AUTH_FALLBACK="false"

# Required: at least one of these six must resolve to a public URL (src/lib/app-url.ts).
# APP_URL is the preferred name for new deployments; the others are accepted for
# backward compatibility with existing deployments.
APP_URL="https://loyaltycarduae.com"
NEXT_PUBLIC_APP_URL="https://loyaltycarduae.com"
NEXT_PUBLIC_SITE_URL="https://loyaltycarduae.com"
AUTH_URL="https://loyaltycarduae.com"
NEXTAUTH_URL="https://loyaltycarduae.com"

RESEND_API_KEY=""
PASSWORD_RESET_FROM_EMAIL="Loyalty Card UAE <no-reply@loyaltycarduae.com>"
SEED_ADMIN_EMAIL="admin@loyaltycarduae.com"
SEED_ADMIN_PASSWORD="change-this-before-running-seed"

# Optional. Google Wallet degrades gracefully and stays disabled until all three are set
# (src/lib/google-wallet/config.ts) - the app boots fine without them.
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# Optional. Sentry runtime error monitoring stays fully disabled until SENTRY_DSN is set
# (sentry.server.config.ts / sentry.edge.config.ts) - the app runs fine without it.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT=""
SENTRY_RELEASE=""
# Only needed to upload source maps at build time; omit to skip source-map upload entirely.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
