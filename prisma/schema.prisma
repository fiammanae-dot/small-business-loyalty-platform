generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLATFORM_OWNER
  BUSINESS_OWNER
  BRANCH_MANAGER
  STAFF
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum SupportSessionStatus {
  ACTIVE
  ENDED
  EXPIRED
}

enum SupportAccessPolicy {
  IMMEDIATE
  APPROVAL_REQUIRED
  EMERGENCY_ACCESS
}

enum SupportRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum SupportSessionActivityType {
  SESSION_STARTED
  SESSION_JOINED
  PAGE_VIEWED
  CUSTOMER_VIEWED
  PROGRAM_VIEWED
  STAFF_VIEWED
  BRANCH_VIEWED
  SETTINGS_VIEWED
  RECORD_CHANGED
  SESSION_ENDED
  SESSION_EXPIRED
}

enum BusinessType {
  COFFEE_SHOP
  RESTAURANT
  BARBERSHOP
  BEAUTY_SALON
  CAR_CARE_CENTER
  OTHER
}

enum CardTheme {
  BUSINESS_DEFAULT
  COFFEE_CAFE
  RESTAURANT
  BEAUTY_SALON
  AUTOMOTIVE
  RETAIL_GENERAL
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionAuditAction {
  PLAN_CHANGED
  STATUS_CHANGED
  TRIAL_ACTIVATED
  TRIAL_EXPIRED
  SUBSCRIPTION_EXTENDED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum CustomerSource {
  STAFF
  OWNER
  IMPORT
  SELF_SIGNUP
}

enum CustomerMembershipStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CardStatus {
  ACTIVE
  DISABLED
}

enum ProgramMembershipStatus {
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED
}

enum ProgramEnrollmentSource {
  OWNER
  BRANCH_MANAGER
}

enum ScanStatus {
  ACTIVE
  DISABLED
}

enum ScanEventResult {
  VALID
  INVALID
  WRONG_BUSINESS
  DISABLED
}

enum StampTransactionSource {
  QR_SCAN
}

enum ActivityAlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActivityAlertStatus {
  OPEN
  ASSIGNED
  UNDER_REVIEW
  RESOLVED
  REVIEWED
  DISMISSED
  ESCALATED
}

enum AlertEventType {
  ALERT_CREATED
  ALERT_UPDATED
  ALERT_ASSIGNED
  ALERT_ESCALATED
  ALERT_RESOLVED
  ALERT_DISMISSED
  ALERT_REOPENED
}

enum EngagementEventType {
  REWARD_READY
  NEAR_REWARD
  BIRTHDAY
  INACTIVE_30_DAYS
  INACTIVE_60_DAYS
  INACTIVE_90_DAYS
  WELCOME_CUSTOMER
  REWARD_REDEEMED
}

enum EngagementEventStatus {
  ACTIVE
  DISMISSED
  RESOLVED
}

enum CommunicationChannel {
  WHATSAPP
  SMS
  EMAIL
  NONE
}

enum MessageDeliveryStatus {
  DRAFT
  READY
  SENT_MANUALLY
  CANCELLED
  FAILED
}

enum CustomerNotificationType {
  NEW_STAMP_EARNED
  TIER_UPGRADED
  REWARD_AVAILABLE
  REFERRAL_REWARD_EARNED
}

enum CustomerNotificationDeliveryStatus {
  READY
  SENT_MANUALLY
  CANCELLED
  FAILED
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REJECTED
  EXPIRED
}

enum ReferralRewardStatus {
  PENDING
  GRANTED
  CANCELLED
}

enum ReferralEventType {
  REFERRAL_CREATED
  SELF_REFERRAL_BLOCKED
  REFERRAL_QUALIFIED
  REWARD_GRANTED
  REWARD_PENDING
}

enum CustomerTierCriteria {
  VISITS_ONLY
}

enum CustomerTierQualificationWindow {
  LIFETIME
  DAYS_30
  DAYS_60
  DAYS_90
  MONTHS_12
}

enum CustomerTierMaintenanceMode {
  PERMANENT
  DYNAMIC
}

enum CustomerTierName {
  BRONZE
  SILVER
  GOLD
  VIP
}

model User {
  id                  Int                 @id @default(autoincrement())
  uuid                String              @unique @default(uuid()) @db.Uuid
  name                String
  email               String              @unique
  passwordHash        String              @map("password_hash")
  sessionVersion      Int                 @default(1) @map("session_version")
  forcePasswordChange Boolean             @default(false) @map("force_password_change")
  passwordChangedAt DateTime            @default(now()) @map("password_changed_at")
  lastLoginAt         DateTime?           @map("last_login_at")
  role                UserRole
  businessId          Int?                @map("business_id")
  branchId            Int?                @map("branch_id")
  status              RecordStatus        @default(ACTIVE)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  business                   Business?                    @relation(fields: [businessId], references: [id])
  branch                     Branch?                      @relation(fields: [branchId], references: [id])
  createdCustomerMemberships BusinessCustomerMembership[]
  scanEvents                 ScanEvent[]
  stampTransactions          StampTransaction[]
  rewardRedemptions          RewardRedemption[]
  activityAlerts             ActivityAlert[]              @relation("ActivityAlertUser")
  reviewedActivityAlerts     ActivityAlert[]              @relation("ActivityAlertReviewer")
  assignedActivityAlerts     ActivityAlert[]              @relation("ActivityAlertAssignee")
  resolvedActivityAlerts     ActivityAlert[]              @relation("ActivityAlertResolver")
  dismissedActivityAlerts    ActivityAlert[]              @relation("ActivityAlertDismisser")
  alertEvents                AlertEvent[]
  subscriptionAudits         SubscriptionAuditLog[]
  createdInvoices            Invoice[]                    @relation("InvoiceCreator")
  recordedPayments           Payment[]
  invoiceAuditLogs           InvoiceAuditLog[]
  preparedMessages           MessageDeliveryQueue[]       @relation("MessagePreparedBy")
  sentMessages               MessageDeliveryQueue[]       @relation("MessageSentBy")
  auditEvents                AuditEvent[]
  cooldownEvents             CooldownEvent[]
  passwordResetTokens PasswordResetToken[]
  supportSessionsStarted SupportSession[] @relation("SupportSessionAdminUser")
  supportRequestsRequested   SupportRequest[]             @relation("SupportRequestRequestedBy")
  supportRequestsReviewed    SupportRequest[]             @relation("SupportRequestReviewedBy")
  supportSessionActivities SupportSessionActivity[] @relation("SupportSessionActivityAdminUser")

  @@index([businessId])
  @@index([branchId])
  @@map("users")
}

model PasswordResetToken {
  id                 Int       @id @default(autoincrement())
  uuid               String    @unique @default(uuid()) @db.Uuid
  userId             Int       @map("user_id")
  tokenHash          String    @unique @map("token_hash")
  expiresAt          DateTime  @map("expires_at")
  usedAt             DateTime? @map("used_at")
  requestedIp        String?   @map("requested_ip")
  requestedUserAgent String?   @map("requested_user_agent")
  createdAt          DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model FailedLoginAudit {
  id             Int      @id @default(autoincrement())
  emailAttempted String   @map("email_attempted")
  ipAddress      String   @map("ip_address")
  userAgent      String?  @map("user_agent")
  outcome        String
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([emailAttempted, createdAt])
  @@index([ipAddress, createdAt])
  @@index([outcome, createdAt])
  @@map("failed_login_audit")
}

model Business {
  id           Int          @id @default(autoincrement())
  uuid         String       @unique @default(uuid()) @db.Uuid
  name         String
  businessType        BusinessType        @map("business_type")
  status              RecordStatus        @default(ACTIVE)
  supportAccessPolicy SupportAccessPolicy @default(IMMEDIATE) @map("support_access_policy")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  users                         User[]
  branches                      Branch[]
  branding                      BusinessBranding?
  subscriptions                 BusinessSubscription[]
  customerMemberships           BusinessCustomerMembership[]
  loyaltyPrograms               LoyaltyProgram[]
  scanEvents                    ScanEvent[]
  stampTransactions             StampTransaction[]
  rewardRedemptions             RewardRedemption[]
  activityAlerts                ActivityAlert[]
  abusePolicies                 AbusePolicy[]
  alertEvents                   AlertEvent[]
  subscriptionAudits            SubscriptionAuditLog[]
  invoices                      Invoice[]
  payments                      Payment[]
  invoiceAuditLogs              InvoiceAuditLog[]
  engagementEvents              EngagementEvent[]
  messageTemplates              MessageTemplate[]
  customerNotificationTemplates CustomerNotificationTemplate[]
  communicationSettings         BusinessCommunicationSettings?
  scannerSettings               BusinessScannerSettings?
  messageDeliveryQueue          MessageDeliveryQueue[]
  customerNotifications         CustomerNotification[]
  referrals                     Referral[]
  referralRewards               ReferralReward[]
  referralEvents                ReferralEvent[]
  auditEvents                   AuditEvent[]
  cooldownRules                 CooldownRule[]
  cooldownEvents                CooldownEvent[]
  tierSetting                   CustomerTierSetting?
  supportSessions               SupportSession[]
  supportRequests               SupportRequest[]
  supportSessionActivities      SupportSessionActivity[]
  businessNotifications BusinessNotification[]

  @@map("businesses")
}

model CustomerTierSetting {
  id                      Int                             @id @default(autoincrement())
  businessId              Int                             @unique @map("business_id")
  criteria                CustomerTierCriteria            @default(VISITS_ONLY)
  tierQualificationWindow CustomerTierQualificationWindow @default(DAYS_90) @map("tier_qualification_window")
  tierMaintenanceMode     CustomerTierMaintenanceMode     @default(DYNAMIC) @map("tier_maintenance_mode")
  silverVisitRequirement  Int                             @default(5) @map("silver_visit_requirement")
  goldVisitRequirement    Int                             @default(15) @map("gold_visit_requirement")
  vipVisitRequirement     Int                             @default(30) @map("vip_visit_requirement")
  createdAt               DateTime                        @default(now()) @map("created_at")
  updatedAt               DateTime                        @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("customer_tier_settings")
}

model Branch {
  id         Int          @id @default(autoincrement())
  uuid       String       @unique @default(uuid()) @db.Uuid
  businessId Int          @map("business_id")
  name       String
  country    String
  city       String
  address    String
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  business                    Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  users                       User[]
  createdCustomerMemberships  BusinessCustomerMembership[]
  scanEvents                  ScanEvent[]
  stampTransactions           StampTransaction[]
  rewardRedemptions           RewardRedemption[]
  activityAlerts              ActivityAlert[]
  referredFirstStampReferrals Referral[]                   @relation("ReferralFirstStampBranch")
  auditEvents                 AuditEvent[]
  cooldownEvents              CooldownEvent[]

  @@index([businessId])
  @@map("branches")
}

model BusinessBranding {
  id              Int      @id @default(autoincrement())
  businessId      Int      @unique @map("business_id")
  logoUrl         String?  @map("logo_url")
  primaryColor    String   @default("#F97316") @map("primary_color")
  secondaryColor  String   @default("#FDBA74") @map("secondary_color")
  backgroundColor String   @default("#FFFFFF") @map("background_color")
  textColor       String   @default("#111827") @map("text_color")
  buttonColor     String   @default("#F97316") @map("button_color")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_branding")
}

model SubscriptionPlan {
  id                  Int      @id @default(autoincrement())
  code                String   @unique
  name                String   @unique
  monthlyPrice        Decimal  @map("monthly_price") @db.Decimal(10, 2)
  annualPrice         Decimal  @map("annual_price") @db.Decimal(10, 2)
  maxBranches         Int      @map("max_branches")
  maxLoyaltyPrograms  Int      @map("max_loyalty_programs")
  billingCycleSupport Json     @map("billing_cycle_support")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  subscriptions BusinessSubscription[]

  @@map("subscription_plans")
}

model BusinessSubscription {
  id                 Int                @id @default(autoincrement())
  businessId         Int                @map("business_id")
  subscriptionPlanId Int                @map("subscription_plan_id")
  status             SubscriptionStatus @default(ACTIVE)
  billingCycle       BillingCycle       @default(YEARLY) @map("billing_cycle")
  startDate          DateTime           @map("start_date")
  trialStartDate     DateTime?          @map("trial_start_date")
  trialEndDate       DateTime?          @map("trial_end_date")
  expiryDate         DateTime?          @map("expiry_date")
  renewalDate        DateTime?          @map("renewal_date")
  endDate            DateTime?          @map("end_date")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  business         Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscriptionPlan SubscriptionPlan       @relation(fields: [subscriptionPlanId], references: [id])
  auditLogs        SubscriptionAuditLog[]
  invoices         Invoice[]

  @@index([businessId])
  @@index([businessId, status, createdAt])
  @@index([status])
  @@index([expiryDate])
  @@index([subscriptionPlanId])
  @@map("business_subscriptions")
}

model SubscriptionAuditLog {
  id                     Int                     @id @default(autoincrement())
  businessId             Int                     @map("business_id")
  businessSubscriptionId Int                     @map("business_subscription_id")
  userId                 Int?                    @map("user_id")
  action                 SubscriptionAuditAction
  previousValue          String?                 @map("previous_value")
  newValue               String?                 @map("new_value")
  createdAt              DateTime                @default(now()) @map("created_at")

  business             Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessSubscription BusinessSubscription @relation(fields: [businessSubscriptionId], references: [id], onDelete: Cascade)
  user                 User?                @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@index([businessSubscriptionId])
  @@index([userId])
  @@index([action])
  @@map("subscription_audit_logs")
}

model Invoice {
  id              Int           @id @default(autoincrement())
  uuid            String        @unique @default(uuid()) @db.Uuid
  businessId      Int           @map("business_id")
  subscriptionId  Int           @map("subscription_id")
  invoiceNumber   String        @unique @map("invoice_number")
  invoiceDate     DateTime      @map("invoice_date")
  dueDate         DateTime      @map("due_date")
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("AED")
  status          InvoiceStatus @default(DRAFT)
  notes           String?
  createdByUserId Int           @map("created_by_user_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  business      Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription  BusinessSubscription @relation(fields: [subscriptionId], references: [id])
  createdByUser User                 @relation("InvoiceCreator", fields: [createdByUserId], references: [id])
  payments      Payment[]
  auditLogs     InvoiceAuditLog[]

  @@index([businessId])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueDate])
  @@index([createdByUserId])
  @@map("invoices")
}

model Payment {
  id               Int           @id @default(autoincrement())
  uuid             String        @unique @default(uuid()) @db.Uuid
  businessId       Int           @map("business_id")
  invoiceId        Int           @map("invoice_id")
  amount           Decimal       @db.Decimal(10, 2)
  currency         String        @default("AED")
  paymentMethod    PaymentMethod @map("payment_method")
  paymentReference String?       @map("payment_reference")
  paidAt           DateTime      @map("paid_at")
  recordedByUserId Int           @map("recorded_by_user_id")
  notes            String?
  createdAt        DateTime      @default(now()) @map("created_at")

  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedByUser User     @relation(fields: [recordedByUserId], references: [id])

  @@index([businessId])
  @@index([invoiceId])
  @@index([recordedByUserId])
  @@index([paidAt])
  @@map("payments")
}

model InvoiceAuditLog {
  id             Int            @id @default(autoincrement())
  invoiceId      Int            @map("invoice_id")
  businessId     Int            @map("business_id")
  userId         Int?           @map("user_id")
  action         String
  previousStatus InvoiceStatus? @map("previous_status")
  newStatus      InvoiceStatus? @map("new_status")
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")

  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id])

  @@index([invoiceId])
  @@index([businessId])
  @@index([userId])
  @@index([action])
  @@map("invoice_audit_logs")
}

model GlobalCustomer {
  id              Int       @id @default(autoincrement())
  uuid            String    @unique @default(uuid()) @db.Uuid
  firstName       String    @map("first_name")
  lastName        String?   @map("last_name")
  phone           String
  normalizedPhone String    @unique @map("normalized_phone")
  email           String?
  birthday        DateTime?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  memberships         BusinessCustomerMembership[]
  referredByReferrals Referral[]

  @@map("global_customers")
}

model BusinessCustomerMembership {
  id               Int                      @id @default(autoincrement())
  uuid             String                   @unique @default(uuid()) @db.Uuid
  globalCustomerId Int                      @map("global_customer_id")
  businessId       Int                      @map("business_id")
  createdBranchId  Int?                     @map("created_branch_id")
  createdByUserId  Int?                     @map("created_by_user_id")
  marketingConsent Boolean                  @default(false) @map("marketing_consent")
  source           CustomerSource           @default(OWNER)
  status           CustomerMembershipStatus @default(ACTIVE)
  cardToken        String                   @unique @map("card_token")
  cardStatus       CardStatus               @default(ACTIVE) @map("card_status")
  cardCreatedAt    DateTime                 @default(now()) @map("card_created_at")
  cardLastViewedAt DateTime?                @map("card_last_viewed_at")
  referralCode     String?                  @map("referral_code")
  referralEnabled  Boolean                  @default(true) @map("referral_enabled")
  currentTier      CustomerTierName         @default(BRONZE) @map("current_tier")
  tierUpdatedAt    DateTime?                @map("tier_updated_at")
  notes            String?
  joinedAt         DateTime                 @default(now()) @map("joined_at")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  globalCustomer        GlobalCustomer              @relation(fields: [globalCustomerId], references: [id], onDelete: Cascade)
  business              Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBranch         Branch?                     @relation(fields: [createdBranchId], references: [id])
  createdByUser         User?                       @relation(fields: [createdByUserId], references: [id])
  programMemberships    CustomerProgramMembership[]
  engagementEvents      EngagementEvent[]
  messageDeliveryQueue  MessageDeliveryQueue[]
  customerNotifications CustomerNotification[]
  referralsMade         Referral[]                  @relation("ReferralReferrer")
  referralsReceived     Referral[]                  @relation("ReferralReferredMembership")

  @@unique([businessId, globalCustomerId])
  @@unique([businessId, referralCode])
  @@index([globalCustomerId])
  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, createdBranchId, status])
  @@index([createdBranchId])
  @@index([createdByUserId])
  @@map("business_customer_memberships")
}

model LoyaltyProgram {
  id                        Int          @id @default(autoincrement())
  uuid                      String       @unique @default(uuid()) @db.Uuid
  joinToken                 String       @unique @default(uuid()) @map("join_token") @db.Uuid
  businessId                Int          @map("business_id")
  name                      String
  businessType              BusinessType @map("business_type")
  productOrServiceName      String       @map("product_or_service_name")
  description               String?
  requiredStamps            Int          @map("required_stamps")
  startingBonusStamps       Int          @default(0) @map("starting_bonus_stamps")
  rewardName                String       @map("reward_name")
  rewardDescription         String       @map("reward_description")
  referralRewardBonusStamps Int          @default(1) @map("referral_reward_bonus_stamps")
  cardTheme                 CardTheme    @default(BUSINESS_DEFAULT) @map("card_theme")
  active                    Boolean      @default(true)
  startDate                 DateTime?    @map("start_date")
  endDate                   DateTime?    @map("end_date")
  createdAt                 DateTime     @default(now()) @map("created_at")
  updatedAt                 DateTime     @updatedAt @map("updated_at")

  business          Business                    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberships       CustomerProgramMembership[]
  rewardRedemptions RewardRedemption[]
  referralRewards   ReferralReward[]
  cooldownEvents    CooldownEvent[]

  @@index([businessId])
  @@index([businessId, active])
  @@map("loyalty_programs")
}

model CustomerProgramMembership {
  id                           Int                     @id @default(autoincrement())
  uuid                         String                  @unique @default(uuid()) @db.Uuid
  businessCustomerMembershipId Int                     @map("business_customer_membership_id")
  loyaltyProgramId             Int                     @map("loyalty_program_id")
  earnedStamps                 Int                     @default(0) @map("earned_stamps")
  bonusStamps                  Int                     @default(0) @map("bonus_stamps")
  enrollmentSource             ProgramEnrollmentSource @map("enrollment_source")
  status                       ProgramMembershipStatus @default(ACTIVE)
  scanToken                    String                  @unique @map("scan_token")
  scanStatus                   ScanStatus              @default(ACTIVE) @map("scan_status")
  scanCreatedAt                DateTime                @default(now()) @map("scan_created_at")
  scanLastUsedAt               DateTime?               @map("scan_last_used_at")
  enrolledAt                   DateTime                @default(now()) @map("enrolled_at")
  createdAt                    DateTime                @default(now()) @map("created_at")
  updatedAt                    DateTime                @updatedAt @map("updated_at")

  businessCustomerMembership BusinessCustomerMembership @relation(fields: [businessCustomerMembershipId], references: [id], onDelete: Cascade)
  loyaltyProgram             LoyaltyProgram             @relation(fields: [loyaltyProgramId], references: [id], onDelete: Cascade)
  scanEvents                 ScanEvent[]
  stampTransactions          StampTransaction[]
  rewardRedemptions          RewardRedemption[]
  activityAlerts             ActivityAlert[]
  referralRewards            ReferralReward[]
  cooldownEvents             CooldownEvent[]

  @@unique([businessCustomerMembershipId, loyaltyProgramId])
  @@index([businessCustomerMembershipId])
  @@index([loyaltyProgramId])
  @@index([loyaltyProgramId, status])
  @@map("customer_program_memberships")
}

model StampTransaction {
  id                          Int                    @id @default(autoincrement())
  businessId                  Int                    @map("business_id")
  branchId                    Int?                   @map("branch_id")
  customerProgramMembershipId Int                    @map("customer_program_membership_id")
  issuedByUserId              Int                    @map("issued_by_user_id")
  quantity                    Int
  reason                      String?
  source                      StampTransactionSource
  idempotencyKey              String?                @unique @map("idempotency_key")
  createdAt                   DateTime               @default(now()) @map("created_at")

  business                  Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch                    Branch?                   @relation(fields: [branchId], references: [id])
  customerProgramMembership CustomerProgramMembership @relation(fields: [customerProgramMembershipId], references: [id])
  issuedByUser              User                      @relation(fields: [issuedByUserId], references: [id])
  referralQualifications    Referral[]

  @@index([businessId])
  @@index([branchId])
  @@index([customerProgramMembershipId])
  @@index([customerProgramMembershipId, createdAt])
  @@index([issuedByUserId])
  @@index([issuedByUserId, createdAt])
  @@index([businessId, createdAt])
  @@map("stamp_transactions")
}

model Referral {
  id                         Int            @id @default(autoincrement())
  uuid                       String         @unique @default(uuid()) @db.Uuid
  businessId                 Int            @map("business_id")
  referrerMembershipId       Int            @map("referrer_membership_id")
  referredGlobalCustomerId   Int?           @map("referred_global_customer_id")
  referredMembershipId       Int?           @map("referred_membership_id")
